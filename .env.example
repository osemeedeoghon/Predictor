# Copy to .env.local and fill in from Supabase: Project Settings -> API.
# Only the public anon key belongs here. Never put the service_role key in
# any VITE_ variable: everything prefixed VITE_ is bundled into the browser.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
